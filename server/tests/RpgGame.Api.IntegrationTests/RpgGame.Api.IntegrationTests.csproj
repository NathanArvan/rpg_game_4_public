<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests against real infrastructure (TESTING_ROADMAP item 3): RedisGameState against
    a real Redis, and the SignalR hub end to end (WebApplicationFactory + HubConnection, real
    Postgres and Redis). Containers come from Testcontainers, so Docker must be running.
    Kept apart from RpgGame.Api.Tests so the unit tests stay instant.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Testcontainers.Redis" Version="4.*" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RpgGame.Api\RpgGame.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Battle presets owned by these tests, so retuning the shipped presets doesn't move them -->
    <None Update="Presets/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

    {
      // Prepared reactions (3B.6 PR 2): queued last, they watch from their tick to the end of the round.
      "id": "brace", "name": "Brace", "activation": "prepared", "ap": 2, "cooldown": 1, "tags": ["melee"],
      "trigger": { "kind": "enemy_enters_reach" },
      "target": { "kind": "trigger" },
      "effects": [ { "kind": "attack", "roll": "melee", "damage": { "die": "weapon", "bonus": 2 } } ]
    },
    {
      "id": "overwatch", "name": "Overwatch", "activation": "prepared", "ap": 2, "cooldown": 1, "tags": ["ranged"],
      "trigger": { "kind": "enemy_moves_within", "range": 6 },
      "target": { "kind": "trigger" },
      "effects": [ { "kind": "attack", "roll": "ranged", "damage": { "die": "weapon" } } ]
    },
    {
      // Attack triggers (3B.6 PR 3): checked after the tick's movement, before any Attack-phase roll.
      "id": "parry", "name": "Parry", "activation": "prepared", "ap": 1, "cooldown": 1, "tags": ["melee"],
      "trigger": { "kind": "attacked", "attackKind": "melee" },
      "target": { "kind": "self" },
      "effects": [ { "kind": "modify_incoming", "dodge": 4 } ]

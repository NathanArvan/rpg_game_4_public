{
  // Shared ability definitions for scenarios. A combatant's "abilities" list can name any of these
  // without the scenario repeating the definition; a scenario's own "abilities" block overrides an
  // entry with the same id (e.g. to try other numbers).
  //
  // These are test versions of the shipped abilities (server/src/RpgGame.Api/Abilities/abilities.json),
  // owned by these tests: retuning the shipped file doesn't change them, so scenarios keep testing
  // mechanics rather than current balance. Change a number here only if every scenario using it
  // should change too.
  "abilities": [
    {
      "id": "power_strike", "name": "Power Strike", "ap": 3, "cooldown": 2, "tags": ["melee"],
      "target": { "kind": "combatant", "filter": "enemy", "range": 1 },
      "effects": [ { "kind": "attack", "roll": "melee", "damage": { "die": "weapon", "bonus": 4 } } ]
    },
    {
      "id": "cleave", "name": "Cleave", "ap": 3, "cooldown": 2, "tags": ["melee"],
      "target": { "kind": "auto", "filter": "enemy", "range": 1 },
      "effects": [ { "kind": "attack", "roll": "melee", "damage": { "die": "weapon" } } ]
    },
    {
      "id": "twin_shot", "name": "Twin Shot", "ap": 3, "cooldown": 1, "tags": ["ranged"],
      "target": { "kind": "combatants", "filter": "enemy", "range": 8, "count": 2 },
      "effects": [ { "kind": "attack", "roll": "ranged", "damage": { "die": "weapon" } } ]
    },
    {
      "id": "mend", "name": "Mend", "ap": 2, "cooldown": 2, "tags": ["healing"],
      "target": { "kind": "combatant", "filter": "ally", "range": 3, "includeSelf": true },
      "effects": [ { "kind": "heal", "amount": { "die": "d6", "bonus": 2 } } ]
    },
    {
      "id": "charge", "name": "Charge", "ap": 3, "cooldown": 2, "tags": ["melee", "movement"],
      "target": { "kind": "combatant", "filter": "enemy", "range": 6 },
      "effects": [
        { "kind": "move", "to": "target", "maxCells": 6, "usesMovementBudget": true },
        { "kind": "attack", "roll": "melee", "damage": { "die": "weapon", "bonusIfMoved": { "minCells": 2, "bonus": 3 } } }
      ]
    },
    {
      "id": "dash", "name": "Dash", "ap": 1, "cooldown": 2, "tags": ["movement"],
      "target": { "kind": "self", "filter": "ally", "range": 0 },
      "effects": [ { "kind": "move", "to": "cell", "maxCells": 3, "usesMovementBudget": false } ]
    },
    {
      "id": "firebolt", "name": "Firebolt", "ap": 3, "cooldown": 1, "tags": ["flame", "ranged", "spell"],
      "target": { "kind": "combatant", "filter": "enemy", "range": 8 },
      "effects": [ { "kind": "attack", "roll": "ranged", "damage": { "die": "d8", "bonus": 1 } } ]
    },
    {
      "id": "battle_cry", "name": "Battle Cry", "ap": 2, "cooldown": 3, "tags": [],
      "target": { "kind": "auto", "filter": "ally", "range": 3, "includeSelf": true },
      "effects": [ { "kind": "apply_condition", "condition": "emboldened", "duration": 1 } ]
    },
    {
      "id": "stoneskin", "name": "Stoneskin", "ap": 1, "cooldown": 3, "tags": [],
      "target": { "kind": "self" },
      "effects": [ { "kind": "apply_condition", "condition": "fortified", "duration": 1 } ]
    },
    {
      "id": "mark", "name": "Mark", "ap": 1, "cooldown": 2, "tags": [],
      "target": { "kind": "combatant", "filter": "enemy", "range": 8 },
      "effects": [
        { "kind": "apply_condition", "condition": "marked", "duration": 1 },
        { "kind": "apply_condition", "condition": "exposed", "duration": 1 }
      ]
    },
    {
      "id": "blinding_strike", "name": "Blinding Strike", "ap": 2, "cooldown": 0, "tags": ["melee"],
      "target": { "kind": "combatant", "filter": "enemy", "range": 1 },
      "effects": [
        { "kind": "attack", "roll": "melee", "damage": { "die": "weapon" } },
        { "kind": "apply_condition", "condition": "dazzled", "duration": 1 }
      ]
    }
  ]
}

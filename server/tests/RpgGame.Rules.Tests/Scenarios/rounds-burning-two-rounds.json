  "combatants": [
    { "id": "A", "side": "party", "at": [2, 2], "abilities": ["ignite"] },
    { "id": "G", "side": "enemy", "at": [6, 2] }
  ],
  "rounds": [
    {
      "plans": { "A": ["ability ignite G"] },
      "dice": [15, 5, 3],
      "expect": { "hp": { "G": 11 }, "conditions": { "G": { "burning": 0 } } }
    },
    {
      "plans": {},
      "dice": [2],
      "expect": {
        "hp": { "G": 9 },
        "conditions": { "G": {} },
        "events": ["end G burning: -2", "end G: burning expires"]
      }
    },
    {
      "plans": {},
      "dice": [],
      "expect": { "hp": { "G": 9 } }
    }
  ]
}

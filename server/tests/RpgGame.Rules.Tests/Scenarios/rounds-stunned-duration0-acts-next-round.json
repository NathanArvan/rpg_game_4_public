  ],
  "rounds": [
    {
      "plans": { "Bruiser": ["ability shield_bash Goblin"], "Goblin": ["move 1,0", "melee Bruiser"] },
      "dice": [14, 2],
      "expect": { "hp": { "Bruiser": 20 }, "conditions": { "Goblin": {} }, "events": ["t2 Goblin stunned: melee Bruiser blocked"] }
    },
    {
      "plans": { "Goblin": ["melee Bruiser", "melee Bruiser"] },
      "dice": [15, 5, 3],
      "expect": { "hp": { "Bruiser": 15 }, "events": ["t1 Goblin melee Bruiser: hit 5", "t2 Goblin melee Bruiser: miss"] }
    }

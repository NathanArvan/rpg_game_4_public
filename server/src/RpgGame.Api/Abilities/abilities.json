{
  // Ability definitions (roadmap 3B.3, docs/design/ABILITIES.md). Combat profiles and battle presets
  // list abilities by id; each combatant stores a copy when it joins an encounter.
  //
  //   id, name, description
  //   ap          AP cost (1–10). Basic actions for comparison: move 1, melee 2, ranged 2, defend 1
  //   cooldown    rounds the ability can't be planned after the round it was used (0 = none).
  //               An ability with a cooldown can be queued at most once per round
  //   tags        mechanic tags (melee, ranged, spell, …) and resonance tags (flame, holy, …)
  //   target      kind:   "self"       the caster only (no filter or range needed)
  //                       "combatant"  one chosen target, tracked like an attack
  //                       "combatants" up to "count" distinct chosen targets, each tracked on its own
  //                       "auto"       everyone matching the filter within range when it resolves
  //                                    (after the tick's movement), nearest first; "count" caps it
  //               filter: "enemy" | "ally" | "any" | "downed_ally"
  //               range:  Chebyshev cells from the caster when it resolves (1 = adjacent). An
  //                       ability that moves checks it when its move starts; its melee attack then
  //                       needs melee reach from where the move ended
  //               count:  "combatants": max targets (required). "auto": max hit (optional)
  //               includeSelf: ally abilities can target the caster too
  //   effects     resolved in order, each in its own phase of the tick:
  //               { "kind": "attack", "roll": "melee" | "ranged" | "none",
  //                 "accuracyBonus": 0,
  //                 "damage": { "die": "weapon" | "d10", "bonus": 0, "multiplier": 1,
  //                             "bonusIfMoved": { "minCells": 2, "bonus": 3 } } }
  //               "weapon" rolls the caster's own damage die. One hit roll per target.
  //               bonusIfMoved (optional): extra damage if the ability's move covered minCells+
  //               { "kind": "move", "to": "cell" | "target", "maxCells": 3, "usesMovementBudget": true }
  //               resolved with the tick's other moves. "cell": a planned cell (needs a "self"
  //               target). "target": the free cell next to the target closest to the caster (needs
  //               a "combatant" target). usesMovementBudget false: on top of the round's movement
  //               { "kind": "heal", "amount": { "die": "d6", "bonus": 2 }, "canRevive": true }
  //               resolved with the attacks and netted with the tick's damage, capped at max HP.
  //               canRevive (default true): brings a downed or stable ally back on their feet
  //               { "kind": "apply_condition", "condition": "marked", "duration": 1, "requiresHit": true }
  //               resolved in the Effects phase on the ability's targets (3B.4). condition: an id from
  //               Conditions/conditions.json. duration: full rounds it lasts after the current one (0 =
  //               until the end of this round; 1 = until the end of next round). requiresHit: only targets
  //               the same ability's attack hit get it (default: true if the ability attacks)
  //   resonanceScaling   optional (MAGIC_SYSTEM.md format). Checked, but only applied from 3M.5
  "abilities": [
    {
      "id": "power_strike", "name": "Power Strike",
      "description": "A heavy melee blow: weapon damage +4.",
      "ap": 3, "cooldown": 2, "tags": ["melee"],
      "target": { "kind": "combatant", "filter": "enemy", "range": 1 },
      "effects": [ { "kind": "attack", "roll": "melee", "damage": { "die": "weapon", "bonus": 4 } } ]
    },
    {
      "id": "cleave", "name": "Cleave",
      "description": "A wide swing that hits every adjacent enemy, each with its own roll.",
      "ap": 3, "cooldown": 2, "tags": ["melee"],
      "target": { "kind": "auto", "filter": "enemy", "range": 1 },
      "effects": [ { "kind": "attack", "roll": "melee", "damage": { "die": "weapon" } } ]
    },
    {
      "id": "twin_shot", "name": "Twin Shot",
      "description": "Two quick shots at up to two enemies within 8 cells.",
      "ap": 3, "cooldown": 1, "tags": ["ranged"],
      "target": { "kind": "combatants", "filter": "enemy", "range": 8, "count": 2 },
      "effects": [ { "kind": "attack", "roll": "ranged", "damage": { "die": "weapon" } } ]
    },
    {
      "id": "mend", "name": "Mend",
      "description": "Heal an ally within 3 cells (or yourself) for d6 + 2. Brings a downed ally back on their feet.",
      "ap": 2, "cooldown": 2, "tags": ["healing"],
      "target": { "kind": "combatant", "filter": "ally", "range": 3, "includeSelf": true },
      "effects": [ { "kind": "heal", "amount": { "die": "d6", "bonus": 2 } } ]
    },
    {
      "id": "charge", "name": "Charge",
      "description": "Run at an enemy up to 6 cells away and strike in the same moment: weapon damage, +3 if you covered 2 or more cells. Uses your movement.",
      "ap": 3, "cooldown": 2, "tags": ["melee", "movement"],
      "target": { "kind": "combatant", "filter": "enemy", "range": 6 },
      "effects": [
        { "kind": "move", "to": "target", "maxCells": 6, "usesMovementBudget": true },
        { "kind": "attack", "roll": "melee", "damage": { "die": "weapon", "bonusIfMoved": { "minCells": 2, "bonus": 3 } } }
      ]
    },
    {
      "id": "dash", "name": "Dash",
      "description": "Sprint up to 3 cells, on top of your normal movement.",
      "ap": 1, "cooldown": 2, "tags": ["movement"],
      "target": { "kind": "self" },
      "effects": [ { "kind": "move", "to": "cell", "maxCells": 3, "usesMovementBudget": false } ]
    },
    {
      "id": "firebolt", "name": "Firebolt",
      "description": "A bolt of flame at a target up to 8 cells away: d8 + 1.",
      "ap": 3, "cooldown": 1, "tags": ["flame", "ranged", "spell"],
      "target": { "kind": "combatant", "filter": "enemy", "range": 8 },
      "effects": [ { "kind": "attack", "roll": "ranged", "damage": { "die": "d8", "bonus": 1 } } ],
      "resonanceScaling": { "flame": { "damagePerLevel": 2, "thresholdEffects": { "2": "ember", "3": "burning" } } }
    },
    {
      "id": "battle_cry", "name": "Battle Cry",
      "description": "You and allies within 3 cells deal +2 damage until the end of next round.",
      "ap": 2, "cooldown": 3, "tags": ["buff"],
      "target": { "kind": "auto", "filter": "ally", "range": 3, "includeSelf": true },
      "effects": [ { "kind": "apply_condition", "condition": "emboldened", "duration": 1 } ]
    },
    {
      "id": "stoneskin", "name": "Stoneskin",
      "description": "Take half damage until the end of next round.",
      "ap": 1, "cooldown": 3, "tags": ["buff"],
      "target": { "kind": "self" },
      "effects": [ { "kind": "apply_condition", "condition": "fortified", "duration": 1 } ]
    },
    {
      "id": "mark", "name": "Mark",
      "description": "Mark an enemy up to 8 cells away: until the end of next round it's easier to hit (-3 Dodge) and takes 2 extra damage per hit.",
      "ap": 1, "cooldown": 2, "tags": ["debuff"],
      "target": { "kind": "combatant", "filter": "enemy", "range": 8 },
      "effects": [
        { "kind": "apply_condition", "condition": "marked", "duration": 1 },
        { "kind": "apply_condition", "condition": "exposed", "duration": 1 }
      ]
    }
  ]
}
